# 1. Токен вашего Telegram-бота (получить бесплатно у @BotFather в Telegram за 20 секунд)
TELEGRAM_BOT_TOKEN=

# 2. Бесплатный ключ Google Gemini API (получить за 2 клика на https://aistudio.google.com/apikey без карты)
GEMINI_API_KEY=

# 3. (Опционально) Резервный бесплатный ключ Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
PORT=7860
